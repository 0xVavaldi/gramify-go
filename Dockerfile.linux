# syntax=docker/dockerfile:1
#
# Cross-compile a Linux gramify binary and export it via a scratch final stage
# so `docker buildx build --output ./bin` (or `docker buildx bake`) writes
# bin/gramify on the host. Build once on any OS with Docker + buildx; no Go
# toolchain or Linux host needed.
#
#   docker buildx build -f Dockerfile.linux --output ./bin .
#
FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build -trimpath -ldflags="-s -w" -o /out/gramify ./cmd/gramify

# Exporting from `scratch` makes `--output type=local,dest=./bin` write only the
# binary to the host (no image layers, no extra files).
FROM scratch AS export
COPY --from=build /out/gramify /gramify
